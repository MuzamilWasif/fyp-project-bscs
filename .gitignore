# Compose / tooling — never commit live secrets
.env
**/.env
.env.*
!**/.env.example
!**/.env.*.example
!**/.env.production.example

# Python
**/__pycache__/
**/*.py[cod]
**/venv/
**/.pytest_cache/

# Node
**/node_modules/
**/dist/

# Uploads / local evidence (keep directory via .gitkeep if present)
backend/uploads/**
!backend/uploads/**/.gitkeep

# Database backups / restore scratch (never commit dumps)
backups/
**/*.dump
**/*.sql.gz
**/pg_restore_tmp/

# AI weights / heavy outputs (tracked samples OK)
**/weights/
**/*.pt

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local AI work (Mac native venv, downloaded datasets, training runs)
**/.venv/
ai/dataset/external/
ai/dataset/openimages/
ai/dataset/ufm_od_v1/
ai/dataset/rtsp_test/
ai/runs/
ai/eval_videos/
*.zip
logs/
